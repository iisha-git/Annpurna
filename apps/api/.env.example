# Annpurna API — copy to .env and fill in (never commit the real .env)
# MongoDB Atlas connection string. Create a cluster → Connect → Drivers, then
# paste the mongodb+srv:// URI with your database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/annpurna?retryWrites=true&w=majority

# Owner login (create the account with: npm run seed)
OWNER_EMAIL=owner@your-domain.example
OWNER_PASSWORD=changeme-to-something-long
OWNER_NAME=Mess Owner

# Auth tokens
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

PORT=4000

# WhatsApp (Meta Cloud API) invites — free tier covers ~1000 service convos/month
# 1) developers.facebook.com → Create App → Business type → choose "WhatsApp" product
# 2) In the WhatsApp Set-up: copy your test number's "Phone number ID" and generate
#    the "Temporary access token" (or a permanent System User token)
# 3) Open "Message templates" → Create: name annpurna_app_invite, language English, body:
#    "Hi {{1}} (Mess {{2}})! Download the Annpurna app: {{3}} In the app tap Create
#    Account, enter your full name, mess number and the mobile on the mess list, set a
#    password, then sign in with your mess number. See menu, crowd & leave daily."
#    Submit for approval.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=annpurna_app_invite
WHATSAPP_COUNTRY_CODE=91
# Install link for your EAS APK build (param {{3}}).
APP_DOWNLOAD_URL=https://expo.dev/accounts/<owner>/projects/<slug>/builds/<id>