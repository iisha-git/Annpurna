# Copy this file to .env and fill in the values from
# Firebase console → Project settings → Your apps → SDK setup & config.
# These identify the project (public by design) — access is controlled by
# Firestore security rules, not by keeping these secret.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
